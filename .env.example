# Copy to .env.local and fill in the values. Never commit real keys.
#
# Local stack: run `npm run db:start`, then `npx supabase status` and copy
#   API URL          -> NEXT_PUBLIC_SUPABASE_URL      (http://127.0.0.1:54321)
#   Publishable key  -> NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   Secret key       -> SUPABASE_SECRET_KEY
# Hosted project: Project Settings -> API Keys.

# --- Public: bundled into browser JavaScript. RLS applies. -----------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy "anon" JWT.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public base URL of the app. Used to build auth email links (confirmation,
# password reset). Must be listed in Supabase Auth's redirect URLs
# (supabase/config.toml -> [auth] additional_redirect_urls for local).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only: BYPASSES RLS. ---------------------------------------------
# Secret key (sb_secret_...) or legacy "service_role" JWT.
# Never prefix with NEXT_PUBLIC_ (the server refuses to start if you do).
# Only read by src/lib/supabase/admin.ts. Auth, onboarding and organization
# switching do NOT use it (they run as the user, under RLS).
SUPABASE_SECRET_KEY=

# --- Server only: Supabase request timeouts (optional). ---------------------
# Leave unset to use the safe defaults. Whole milliseconds between 1000 and
# 30000; anything else falls back to the default (with a warning that names
# only the variable). Used by the server, proxy and admin Supabase clients,
# not by the browser client. Keep the Auth deadline above the request timeout.
# Per HTTP request to Supabase Auth / Data API (default 6000):
# SUPABASE_REQUEST_TIMEOUT_MS=6000
# Whole Auth call such as getUser()/getClaims() incl. refresh retries (default 7000):
# SUPABASE_AUTH_DEADLINE_MS=7000
